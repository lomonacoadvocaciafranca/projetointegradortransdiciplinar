from fastapi import FastAPI, HTTPException
import sqlite3

app = FastAPI(title="API Vitrine de Cupcakes")

def get_db_connection():
    # Conecta ao banco de dados SQLite
    conn = sqlite3.connect('cupcakes.db')
    # Permite acessar as colunas pelo nome
    conn.row_factory = sqlite3.Row
    return conn

@app.get("/api/cupcakes")
def listar_cupcakes_ativos():
    """
    Retorna a lista de produtos ativos com nome, descrição, 
    preço, imagem e status de estoque.
    """
    conn = get_db_connection()
    
    query = """
        SELECT id, nome, descricao, preco, imagem_url, estoque 
        FROM cupcakes 
        WHERE ativo = 1
    """
    
    resultados = conn.execute(query).fetchall()
    conn.close()
    
    # Converte os resultados em uma lista de dicionários
    cupcakes = [dict(row) for row in resultados]
    return cupcakes

# Nova rota adicionada para atender aos requisitos da US02
@app.get("/api/cupcakes/{cupcake_id}")
def obter_detalhes_cupcake(cupcake_id: int):
    """
    Retorna todos os detalhes de um cupcake específico filtrado pelo ID, 
    incluindo ingredientes, tabela nutricional e alergênicos.
    """
    conn = get_db_connection()
    
    query = """
        SELECT id, nome, descricao, preco, imagem_url, estoque, 
               ingredientes, tabela_nutricional, alergenicos 
        FROM cupcakes 
        WHERE id = ? AND ativo = 1
    """
    
    resultado = conn.execute(query, (cupcake_id,)).fetchone()
    conn.close()
    
    # Caso o ID informado não exista ou o produto não esteja ativo
    if resultado is None:
        raise HTTPException(status_code=404, detail="Cupcake não encontrado")
        
    # Retorna o registro encontrado convertido em dicionário
    return dict(resultado)
