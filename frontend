import streamlit as st
import requests

st.set_page_config(page_title="Vitrine de Cupcakes", page_icon="🧁", layout="wide")

# Gerenciamento de estado para saber se um cupcake foi clicado
if 'cupcake_selecionado' not in st.session_state:
    st.session_state.cupcake_selecionado = None

@st.cache_data(ttl=60)
def buscar_cupcakes():
    try:
        resposta = requests.get("http://127.0.0.1:8000/api/cupcakes")
        resposta.raise_for_status()
        return resposta.json()
    except requests.exceptions.RequestException:
        return []

def buscar_detalhes(cupcake_id):
    try:
        resposta = requests.get(f"http://127.0.0.1:8000/api/cupcakes/{cupcake_id}")
        resposta.raise_for_status()
        return resposta.json()
    except requests.exceptions.RequestException:
        return None

# ==========================================
# TELA 2: DETALHES DO PRODUTO (US02)
# ==========================================
if st.session_state.cupcake_selecionado is not None:
    cupcake_id = st.session_state.cupcake_selecionado
    produto = buscar_detalhes(cupcake_id)
    
    # Botão de voltar
    if st.button("⬅️ Voltar para o Catálogo"):
        st.session_state.cupcake_selecionado = None
        st.rerun()
        
    if produto:
        st.title(produto['nome'])
        col1, col2 = st.columns([1, 2])
        
        with col1:
            st.image(produto["imagem_url"], use_container_width=True)
            preco_formatado = f"R$ {produto['preco']:.2f}".replace('.', ',')
            st.subheader(preco_formatado)
            
            # Campo para selecionar a quantidade (Critério de Aceite 2)
            max_qtd = produto['estoque'] if produto['estoque'] > 0 else 1
            quantidade = st.number_input("Quantidade desejada:", min_value=1, max_value=max_qtd, step=1, disabled=(produto['estoque'] == 0))
            
            if produto['estoque'] > 0:
                st.button("🛒 Adicionar ao Carrinho", type="primary")
            else:
                st.error("Produto Esgotado")
                
        with col2:
            st.markdown("### Descrição")
            st.write(produto['descricao'])
            
            # Informações detalhadas (Critério de Aceite 1)
            st.markdown("### 📝 Ingredientes")
            st.write(produto.get('ingredientes', 'Informação indisponível.'))
            
            st.markdown("### ⚠️ Alergênicos")
            st.warning(produto.get('alergenicos', 'Nenhuma informação de alergênicos.'))
            
            st.markdown("### 📊 Tabela Nutricional")
            st.info(produto.get('tabela_nutricional', 'Informação indisponível.'))
    else:
        st.error("Erro ao carregar os detalhes do produto.")

# ==========================================
# TELA 1: VITRINE DE CUPCAKES
# ==========================================
else:
    st.title("🧁 Catálogo de Cupcakes")
    st.markdown("Confira nossos sabores disponíveis!")
    st.divider()

    produtos = buscar_cupcakes()

    if not produtos:
        st.warning("Nenhum cupcake disponível no momento.")
    else:
        colunas = st.columns(3)
        
        for index, produto in enumerate(produtos):
            with colunas[index % 3]:
                with st.container(border=True):
                    st.image(produto["imagem_url"], use_container_width=True)
                    st.subheader(produto["nome"])
                    st.write(produto["descricao"])
                    
                    preco_formatado = f"R$ {produto['preco']:.2f}".replace('.', ',')
                    st.markdown(f"**Preço:** {preco_formatado}")
                    
                    if produto["estoque"] > 5:
                        st.success(f"Em estoque ({produto['estoque']} unidades)")
                    elif 0 < produto["estoque"] <= 5:
                        st.warning(f"Últimas unidades! ({produto['estoque']} restam)")
                    else:
                        st.error("Esgotado")
                    
                    # Botão para acionar a visualização de detalhes (História do Usuário)
                    if st.button("Ver Detalhes", key=f"detalhes_{produto['id']}"):
                        st.session_state.cupcake_selecionado = produto['id']
                        st.rerun()
